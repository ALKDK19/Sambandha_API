# Database Configuration
DATABASE_URL='your_database_url_here'

# Security Keys (GENERATE STRONG RANDOM KEYS - minimum 32 characters)
SECRET_KEY=your_generated_secret_key_here
ADMIN_SECRET_KEY=your_generated_admin_secret_key_here

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=email_from
EMAIL_FROM_NAME=email_from_name

# Application Settings
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:8080"]

# --- FIRST ADMIN SEEDING (only used on first startup if no admins exist) ---
FIRST_ADMIN_USERNAME="sambandhaadmin"
FIRST_ADMIN_EMAIL="admin@sambandha.app"
FIRST_ADMIN_FULL_NAME="Sambandha Super Admin"
FIRST_ADMIN_PASSWORD="a_very_strong_and_secret_password_here"

# Firebase Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/firebase/credentials.json

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

